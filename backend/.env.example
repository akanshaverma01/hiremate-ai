# Copy this file to ".env" and fill in your own values. Never commit ".env".

# PostgreSQL. "postgresql+psycopg://" is the explicit form; plain "postgresql://"
# or "postgres://" also work (config.py converts them to the psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://ats_user:ats_password@localhost:5432/ats_resume_db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads
# Exact URL of the frontend (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini (get a key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Model id. Set it explicitly - the default baked into app/config.py is the
# retired "gemini-3.5-flash", which only keeps working while Google redirects it.
GEMINI_MODEL=gemini-3.6-flash

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP for password-reset emails. If left blank, the reset link is printed
# in the backend console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@hiremate.ai
